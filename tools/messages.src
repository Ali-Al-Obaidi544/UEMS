error.announcement.required ## Subject and message are required. ## العنوان والرسالة مطلوبان.
error.catalog.name ## Enter a name (English is required). ## أدخل اسماً (الاسم الإنجليزي مطلوب).
error.checkin.notConfirmed ## Only confirmed registrations can be checked in. ## يمكن تسجيل حضور المسجلين المؤكدين فقط.
error.checkin.sessionRequired ## Choose the workshop session. ## اختر جلسة الورشة.
error.checkin.window ## Check-in is possible from 30 minutes before the start until 24 hours after the end. ## تسجيل الحضور متاح قبل البدء بـ 30 دقيقة وحتى 24 ساعة بعد الانتهاء.
error.clash ## This clashes with your registration for {0} ({1}). ## يتعارض هذا مع تسجيلك في {0} ({1}).
error.club.alreadyDecided ## This request has already been decided. ## تم البت في هذا الطلب مسبقاً.
error.club.alreadyMember ## You already belong to this club or have a pending request. ## أنت عضو في هذا النادي بالفعل أو لديك طلب قيد الانتظار.
error.club.alreadyOfficer ## This person is already an officer of the club. ## هذا الشخص مسؤول في النادي بالفعل.
error.club.inactive ## The club is not active. ## النادي غير نشط.
error.club.lastOfficer ## An active club needs at least one officer. ## يحتاج النادي النشط إلى مسؤول واحد على الأقل.
error.club.nameRequired ## Enter the club name. ## أدخل اسم النادي.
error.club.notFound ## Club not found. ## لم يتم العثور على النادي.
error.club.notMember ## Not a member of this club. ## لست عضواً في هذا النادي.
error.club.notOfficer ## This person is not an officer of the club. ## هذا الشخص ليس مسؤولاً في النادي.
error.club.removeOfficerViaStaff ## Officers can only be removed by Staff. ## يمكن للموظفين فقط إزالة المسؤولين.
error.club.requestNotFound ## Join request not found. ## لم يتم العثور على طلب الانضمام.
error.club.staffOfficer ## Staff accounts cannot be club officers. ## لا يمكن لحسابات الموظفين أن تكون مسؤولة في نادٍ.
error.comment.empty ## The comment is empty. ## التعليق فارغ.
error.comment.nesting ## Replies to replies are not supported. ## الرد على الردود غير مدعوم.
error.comment.notFound ## Comment not found. ## لم يتم العثور على التعليق.
error.comment.removed ## This comment was removed. ## تمت إزالة هذا التعليق.
error.db ## A database error occurred. Please try again. ## حدث خطأ في قاعدة البيانات. يرجى المحاولة مرة أخرى.
error.db.busy ## The system is busy. Please try again in a moment. ## النظام مشغول. يرجى المحاولة بعد قليل.
error.db.unreachable ## The database cannot be reached. Check the connection and try again. ## تعذر الاتصال بقاعدة البيانات. تحقق من الاتصال وحاول مرة أخرى.
error.discussion.readOnly ## The discussion is closed (read-only). ## النقاش مغلق (للقراءة فقط).
error.discussion.unavailable ## There is no discussion for this event yet. ## لا يوجد نقاش لهذه الفعالية بعد.
error.event.cancelDeadline ## The cancellation deadline must not be after the start. ## يجب ألا يكون آخر موعد للإلغاء بعد وقت البدء.
error.event.capacity ## Enter a valid capacity. ## أدخل سعة صحيحة.
error.event.capacityBelowConfirmed ## The capacity cannot be lower than the {0} confirmed registrations. ## لا يمكن أن تقل السعة عن {0} تسجيلاً مؤكداً.
error.event.capacityRange ## The capacity must be between 1 and the venue capacity ({0}). ## يجب أن تكون السعة بين 1 وسعة القاعة ({0}).
error.event.endBeforeStart ## The end must be after the start. ## يجب أن يكون الانتهاء بعد البدء.
error.event.notDeletable ## Only drafts can be deleted (current state: {0}). ## يمكن حذف المسودات فقط (الحالة الحالية: {0}).
error.event.notEditable ## The event cannot be edited in its current state ({0}). ## لا يمكن تعديل الفعالية في حالتها الحالية ({0}).
error.event.notFound ## Event not found. ## لم يتم العثور على الفعالية.
error.event.regDeadline ## The registration deadline must not be after the start. ## يجب ألا يكون آخر موعد للتسجيل بعد وقت البدء.
error.event.regOpens ## Registration cannot open after its deadline. ## لا يمكن أن يفتح التسجيل بعد آخر موعد له.
error.event.startPast ## The start must be in the future. ## يجب أن يكون وقت البدء في المستقبل.
error.event.timesRequired ## Enter start and end times (or sessions for a workshop). ## أدخل وقتي البدء والانتهاء (أو الجلسات للورشة).
error.event.titleRequired ## Enter a title in English or Arabic. ## أدخل عنواناً بالإنجليزية أو العربية.
error.event.transition ## This action ({0}) is not allowed in state {1}. ## هذا الإجراء ({0}) غير مسموح في الحالة {1}.
error.event.typeChange ## The event type cannot be changed. ## لا يمكن تغيير نوع الفعالية.
error.event.useProposal ## Club proposals must be approved, not published directly. ## يجب اعتماد اقتراحات الأندية بدلاً من نشرها مباشرة.
error.event.venueRequired ## Choose a venue. ## اختر قاعة.
error.feedback.closed ## The feedback period (30 days) has ended. ## انتهت فترة التقييم (30 يوماً).
error.feedback.editClosed ## Feedback can only be edited within 7 days. ## يمكن تعديل التقييم خلال 7 أيام فقط.
error.feedback.exists ## You have already given feedback for this event. ## لقد قدمت تقييماً لهذه الفعالية بالفعل.
error.feedback.notAttended ## Only students who attended can give feedback. ## يمكن للطلاب الذين حضروا فقط تقديم تقييم.
error.feedback.notCompleted ## Feedback is possible after the event is completed. ## التقييم متاح بعد اكتمال الفعالية.
error.feedback.notFound ## Feedback not found. ## لم يتم العثور على التقييم.
error.feedback.rating ## The rating must be between 1 and 5. ## يجب أن يكون التقييم بين 1 و 5.
error.file.read ## The file could not be read. ## تعذرت قراءة الملف.
error.file.write ## The file could not be written. ## تعذرت كتابة الملف.
error.forbidden ## You do not have permission for this action. ## ليست لديك صلاحية لهذا الإجراء.
error.import.line ## Invalid data in line {0}. Nothing was imported. ## بيانات غير صحيحة في السطر {0}. لم يتم استيراد أي شيء.
error.input.date ## Enter a date as yyyy-MM-dd. ## أدخل التاريخ بصيغة yyyy-MM-dd.
error.input.datetime ## Enter date and time as yyyy-MM-dd HH:mm. ## أدخل التاريخ والوقت بصيغة yyyy-MM-dd HH:mm.
error.login.disabled ## This account is disabled. Contact the administrator. ## هذا الحساب معطل. تواصل مع مدير النظام.
error.login.invalid ## The university ID or password is incorrect. ## الرقم الجامعي أو كلمة المرور غير صحيحة.
error.login.locked ## Too many failed attempts. The account is locked until {0}. ## محاولات فاشلة كثيرة. الحساب مقفل حتى {0}.
error.mustChangePassword ## Change your password first (Profile). ## غيّر كلمة المرور أولاً (الملف الشخصي).
error.password.mismatch ## The new passwords do not match. ## كلمتا المرور الجديدتان غير متطابقتين.
error.password.weak ## The password needs at least 8 characters with letters and digits. ## يجب أن تتكون كلمة المرور من 8 أحرف على الأقل وتحتوي على حروف وأرقام.
error.password.wrongOld ## The current password is incorrect. ## كلمة المرور الحالية غير صحيحة.
error.poster.size ## The poster must be at most 2 MB. ## يجب ألا يتجاوز حجم الملصق 2 ميغابايت.
error.poster.type ## The poster must be a PNG or JPEG image. ## يجب أن يكون الملصق صورة PNG أو JPEG.
error.reason.required ## A reason is required. ## السبب مطلوب.
error.recurrence.count ## At most {0} occurrences are allowed. ## الحد الأقصى المسموح {0} حدثاً.
error.recurrence.end ## Enter an end date or a number of occurrences. ## أدخل تاريخ انتهاء أو عدد التكرارات.
error.recurrence.generalOnly ## Only general events can recur. ## يمكن للفعاليات العامة فقط أن تتكرر.
error.recurrence.interval ## The interval must be at least 1. ## يجب أن تكون الفترة 1 على الأقل.
error.registration.cancelClosed ## The cancellation deadline ({0}) has passed. ## انتهى آخر موعد للإلغاء ({0}).
error.registration.duplicate ## You are already registered for this event. ## أنت مسجل في هذه الفعالية بالفعل.
error.registration.notFound ## Registration not found. ## لم يتم العثور على التسجيل.
error.registration.notOpen ## Registration is not open for this event. ## التسجيل غير متاح لهذه الفعالية.
error.registration.transition ## This action ({0}) is not allowed for a {1} registration. ## هذا الإجراء ({0}) غير مسموح لتسجيل بحالة {1}.
error.results.alreadyPublished ## The results are already published; Staff can correct them. ## النتائج منشورة بالفعل؛ يمكن للموظفين تصحيحها.
error.results.duplicate ## A participant can only be placed once. ## لا يمكن ترتيب المشارك أكثر من مرة.
error.results.empty ## Enter at least one placement first. ## أدخل ترتيباً واحداً على الأقل أولاً.
error.results.notAttended ## Only participants who attended can be placed. ## يمكن ترتيب المشاركين الذين حضروا فقط.
error.results.notCompetition ## This event is not a competition. ## هذه الفعالية ليست مسابقة.
error.results.notPublished ## The results are not published yet. ## لم يتم نشر النتائج بعد.
error.results.notYet ## Results can be entered once the event has started. ## يمكن إدخال النتائج بعد بدء الفعالية.
error.results.placement ## A placement must be 1, 2 or 3. ## يجب أن يكون الترتيب 1 أو 2 أو 3.
error.results.score ## The score must be a non-negative number. ## يجب أن تكون الدرجة رقماً غير سالب.
error.series.conflicts ## The venue is not free on the occurrences {0}. Skip them or choose another venue. ## القاعة غير متاحة في التكرارات {0}. تخطَّها أو اختر قاعة أخرى.
error.series.empty ## No occurrences are left to create. ## لا توجد تكرارات متبقية للإنشاء.
error.series.notInSeries ## This event is not part of a series. ## هذه الفعالية ليست جزءاً من سلسلة.
error.session.expired ## Your session has expired. Please sign in again. ## انتهت جلستك. يرجى تسجيل الدخول مرة أخرى.
error.session.notFound ## Session not found. ## لم يتم العثور على الجلسة.
error.setting.range ## Enter a whole number between 1 and 600. ## أدخل عدداً صحيحاً بين 1 و 600.
error.setting.unknown ## Unknown setting. ## إعداد غير معروف.
error.slot.invalid ## The end must be after the start. ## يجب أن يكون الانتهاء بعد البدء.
error.stale ## Someone else changed this record. Reload and try again. ## قام شخص آخر بتغيير هذا السجل. أعد التحميل وحاول مرة أخرى.
error.text.tooLong ## The text is too long (maximum {1} characters). ## النص طويل جداً (الحد الأقصى {1} حرفاً).
error.unexpected ## An unexpected error occurred. ## حدث خطأ غير متوقع.
error.user.anonymized ## This account has been anonymized. ## تم إخفاء هوية هذا الحساب.
error.user.duplicateId ## This university ID already exists. ## هذا الرقم الجامعي موجود بالفعل.
error.user.emailInvalid ## Enter a valid e-mail address. ## أدخل بريداً إلكترونياً صحيحاً.
error.user.idRequired ## Enter the university ID. ## أدخل الرقم الجامعي.
error.user.inactive ## The account is not active. ## الحساب غير نشط.
error.user.lastAdmin ## The last active administrator cannot be removed or disabled. ## لا يمكن إزالة أو تعطيل آخر مدير نشط.
error.user.nameRequired ## Enter the name. ## أدخل الاسم.
error.user.notFound ## User not found. ## لم يتم العثور على المستخدم.
error.user.staffOfficer ## This person is a club officer and cannot become Staff. ## هذا الشخص مسؤول في نادٍ ولا يمكن أن يصبح موظفاً.
error.venue.capacity ## Enter a capacity of at least 1. ## أدخل سعة لا تقل عن 1.
error.venue.conflict ## The venue is already booked: {0} ## القاعة محجوزة بالفعل: {0}
error.venue.hasBookings ## The venue has future bookings. ## للقاعة حجوزات مستقبلية.
error.venue.inactive ## The venue is not active. ## القاعة غير نشطة.
error.venue.nameRequired ## Enter the venue name. ## أدخل اسم القاعة.
error.venue.notFound ## Venue not found. ## لم يتم العثور على القاعة.
error.workshop.noSessions ## A workshop needs at least one session. ## تحتاج الورشة إلى جلسة واحدة على الأقل.
error.workshop.notWorkshop ## This event is not a workshop. ## هذه الفعالية ليست ورشة عمل.
error.workshop.overlap ## Workshop sessions must not overlap. ## يجب ألا تتداخل جلسات الورشة.
